@model IEnumerable<WebApp.Models.congVan>
@using WebApp.Libs
@{
    ViewData["Title"] = "Báo Cáo Công Văn";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
    var filter = ViewBag.Filter as WebApp.Controllers.BaoCaoController.BaoCaoFilterModel;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-chart-bar"></i> Báo Cáo Thống Kê Công Văn
                    </h4>
                </div>
                
                <!-- Bộ lọc -->
                <div class="card-body">
                    <form method="get" class="row g-3 mb-4">
                        <div class="col-md-2">
                            <label class="form-label">Năm</label>
                            <select name="Nam" class="form-select">
                                @foreach (var year in ViewBag.AvailableYears)
                                {
                                    <option value="@year" selected="@(filter?.Nam == year)">@year</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-2">
                            <label class="form-label">Tháng</label>
                            <select name="Thang" class="form-select">
                                <option value="">Tất cả</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i" selected="@(filter?.Thang == i)">Tháng @i</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-2">
                            <label class="form-label">Loại công văn</label>
                            <select name="LoaiCongVan" class="form-select">
                                <option value="">Tất cả</option>
                                <option value="CongVanDen" selected="@(filter?.LoaiCongVan?.ToString() == "CongVanDen")">Công văn đến</option>
                                <option value="CongVanDi" selected="@(filter?.LoaiCongVan?.ToString() == "CongVanDi")">Công văn đi</option>
                            </select>
                        </div>
                        
                        <div class="col-md-2">
                            <label class="form-label">Số lượng</label>
                            <select name="PageSize" class="form-select">
                                <option value="10" selected="@(filter?.PageSize == 10)">10</option>
                                <option value="20" selected="@(filter?.PageSize == 20)">20</option>
                                <option value="50" selected="@(filter?.PageSize == 50)">50</option>
                                <option value="100" selected="@(filter?.PageSize == 100)">100</option>
                            </select>
                        </div>
                        
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fas fa-filter"></i> Lọc
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary me-2">
                                <i class="fas fa-redo"></i> Xóa
                            </a>
                            <div class="btn-group">
                                <button type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-download"></i> Xuất 
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("ExportPdf", new { filter.Nam, filter.Thang, filter.LoaiCongVan })">
                                            <i class="fas fa-file-pdf text-danger"></i> Xuất PDF
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("ExportExcel", new { filter.Nam, filter.Thang, filter.LoaiCongVan })">
                                            <i class="fas fa-file-excel text-success"></i> Xuất Excel
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </form>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                            <div class="p-4 flex items-center justify-between">
                                <div class="flex-shrink-0 bg-blue-100 p-3 rounded-md">
                                    <i class="fas fa-inbox text-blue-500 text-xl"></i>
                                </div>
                                <div class="flex-1 ml-4 text-right">
                                    <p class="text-sm font-medium text-gray-500">Tổng số công văn</p>
                                    <p id="incomingCount" class="text-2xl font-semibold text-gray-800">@ViewBag.TongCongVan</p>
                                </div>
                            </div>
                           
                        </div>
                        
                        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                            <div class="p-4 flex items-center justify-between">
                                <div class="flex-shrink-0 bg-green-100 p-3 rounded-md">
                                    <i class="fas fa-paper-plane text-green-500 text-xl"></i>
                                </div>
                                <div class="flex-1 ml-4 text-right">
                                    <p class="text-sm font-medium text-gray-500">Công văn đến</p>
                                    <p id="outgoingCount" class="text-2xl font-semibold text-gray-800">@ViewBag.SoCongVanDen</p>
                                </div>
                            </div>
                           
                        </div>
                        
                        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                            <div class="p-4 flex items-center justify-between">
                                <div class="flex-shrink-0 bg-yellow-100 p-3 rounded-md">
                                    <i class="fas fa-clock text-yellow-500 text-xl"></i>
                                </div>
                                <div class="flex-1 ml-4 text-right">
                                    <p class="text-sm font-medium text-gray-500">Công văn đi</p>
                                    <p id="employeeCount" class="text-2xl font-semibold text-gray-800">@ViewBag.SoCongVanDi</p>
                                </div>
                            </div>
                           
                        </div>
                        
                        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                            <div class="p-4 flex items-center justify-between">
                                <div class="flex-shrink-0 bg-indigo-100 p-3 rounded-md">
                                    <i class="fas fa-chart-line text-indigo-500 text-xl"></i>
                                </div>
                                <div class="flex-1 ml-4 text-right">
                                    <p class="text-sm font-medium text-gray-500">Năm hiện tại</p>
                                    <p class="text-2xl font-semibold text-indigo-500">@DateTime.Now.Year</p>
                                </div>
                            </div>
                           
                        </div>
                    </div> 
                    <!-- Thống kê tổng quan -->
                    

                    <!-- Biểu đồ -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">Thống kê công văn theo tháng - Năm @ViewBag.NamThongKe</h5>
                                </div>
                                <div class="card-body">
                                    <canvas id="thongKeChart" height="100"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Biểu đồ đường -->
                   
                    <div class="row mb-4">
                        <!-- Biểu đồ đường (bên trái) -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">Biểu đồ đường - Xu hướng công văn trong năm @ViewBag.NamThongKe</h5>
                                </div>
                                <div class="card-body">
                                    <canvas id="lineChart" height="150"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Biểu đồ tròn (bên phải) -->
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-header">
                                    <h5 class="mb-0">Biểu đồ tròn - Tỷ lệ công văn đến / đi</h5>
                                </div>
                                <div class="card-body d-flex justify-content-center align-items-center">
                                    <div style="width: 65%; max-width: 260px;">
                                        <canvas id="pieChart"></canvas>
                                    </div>
                                                    
                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- Danh sách công văn -->
                    <div class="card">
                     
                        <div class="card-body">
                            @if (Model.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover rounded ">
                                        <thead>
                                            <tr class="text-center bg-light">
                                                <th>STT</th>
                                                <th>Số hiệu</th>
                                                <th>Loại</th>
                                                <th>Ngày</th>
                                                <th>Nơi phát hành</th>
                                                <th>Nơi nhận</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int index = (filter.Page - 1) * filter.PageSize + 1;
                                            }
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td class="text-center">@(index++)</td>
                                                    <td class="text-center">@item.SoHieu</td>
                                                    <td class="text-center">
                                                        <span class="badge @(item.LoaiCongVan == LoaiCongVan.CongVanDen ? "bg-success" : "bg-warning")">
                                                            @item.LoaiCongVan
                                                        </span>
                                                    </td>
                                                    <td class="text-center">@item.Ngay.ToString("dd/MM/yyyy")</td>
                                                    <td>@item.NoiPhatHanh?.TenNoiPhatHanh</td>
                                                    <td>@item.NoiNhan?.TenNoiNhan</td>
                                                    @* <td>@(item.TrichYeu?.Length > 50 ? item.TrichYeu.Substring(0, 50) + "..." : item.TrichYeu)</td> *@
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Phân trang -->
                                @if (ViewBag.TotalPages > 1)
                                {
                                    <nav aria-label="Page navigation">
                                        <ul class="pagination justify-content-center">
                                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                            {
                                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                    <a class="page-link" 
                                                       href="@Url.Action("Index", new { 
                                                            Page = i, 
                                                            PageSize = filter.PageSize,
                                                            Nam = filter.Nam,
                                                            Thang = filter.Thang,
                                                            LoaiCongVan = filter.LoaiCongVan
                                                       })">@i</a>
                                                </li>
                                            }
                                        </ul>
                                    </nav>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle"></i> Không có dữ liệu công văn
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="../assets/css/styles.min.css" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Lấy dữ liệu từ ViewBag
            var thangDen = @Html.Raw(Json.Serialize(ViewBag.ThangDen));
            var thangDi = @Html.Raw(Json.Serialize(ViewBag.ThangDi));
            var labels = @Html.Raw(Json.Serialize(ViewBag.ThangLabels));

            // Chuẩn bị dữ liệu cho chart
            var denData = thangDen.map(x => x.soLuong);
            var diData = thangDi.map(x => x.soLuong);

            // Vẽ biểu đồ
            var ctx = document.getElementById('thongKeChart').getContext('2d');
            var chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Công văn đến',
                            data: denData,
                            backgroundColor: 'rgba(40, 167, 69, 0.8)',
                            borderColor: 'rgba(40, 167, 69, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'Công văn đi',
                            data: diData,
                            backgroundColor: 'rgba(255, 193, 7, 0.8)',
                            borderColor: 'rgba(255, 193, 7, 1)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    }
                }
            });
            // ============================
//  BIỂU ĐỒ ĐƯỜNG
// ============================
            var ctxLine = document.getElementById('lineChart').getContext('2d');

            var lineChart = new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Công văn đến',
                            data: denData,
                            fill: false,
                            borderColor: 'rgba(40, 167, 69, 1)',
                            backgroundColor: 'rgba(40, 167, 69, 0.8)',
                            tension: 0.3,
                            borderWidth: 2,
                        },
                        {
                            label: 'Công văn đi',
                            data: diData,
                            fill: false,
                            borderColor: 'rgba(255, 193, 7, 1)',
                            backgroundColor: 'rgba(255, 193, 7, 0.8)',
                            tension: 0.3,
                            borderWidth: 2,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'top' } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });


            // ============================
            //  BIỂU ĐỒ TRÒN
            // ============================

            // Tổng công văn theo năm
            var tongDen = denData.reduce((a, b) => a + b, 0);
            var tongDi = diData.reduce((a, b) => a + b, 0);

            var ctxPie = document.getElementById('pieChart').getContext('2d');

            var pieChart = new Chart(ctxPie, {
                type: 'pie',
                data: {
                    labels: ['Công văn đến', 'Công văn đi'],
                    datasets: [{
                        data: [tongDen, tongDi],
                        backgroundColor: [
                            'rgba(40, 167, 69, 0.8)',
                            'rgba(255, 193, 7, 0.8)'
                        ],
                        borderColor: [
                            'rgba(40, 167, 69, 1)',
                            'rgba(255, 193, 7, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

        });
    </script>
}