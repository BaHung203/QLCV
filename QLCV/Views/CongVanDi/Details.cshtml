@model WebApp.Models.congVan
@using WebApp.Data
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = "Chi tiết công văn đi";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
    AppDbContext _db = Context.RequestServices.GetService(typeof(AppDbContext)) as AppDbContext;

    var latest = _db.XuLyCongVan
        .Include(x => x.NhanVien)
        .Where(x => x.IdCongVan == Model.ID)
        .OrderByDescending(x => x.NgayXuLy)
        .FirstOrDefault();
}

<div class="container-fluid">
    <div class="container-fluid ">
        <div class="text-center">
            <h2 class="mb-4">Chi tiết công văn đi</h2>
        </div>
        <div class="mb-3 p-3 border rounded bg-light">
        <h5>Trạng thái xử lý hiện tại:</h5>

        @if (latest == null)
        {
            <span class="badge bg-secondary">Chưa xử lý</span>
        }
        else
        {
            if (latest.TrangThai == WebApp.Libs.TrangThaiXuLy.DangCho)
            {
                <span class="badge bg-secondary">Đang chờ</span>
            }
            else if (latest.TrangThai == WebApp.Libs.TrangThaiXuLy.DangXuLy)
            {
                <span class="badge bg-warning text-dark">Đang xử lý</span>
            }
            else if (latest.TrangThai == WebApp.Libs.TrangThaiXuLy.DaHoanThanh)
            {
                <span class="badge bg-success">Đã xử lý</span>
            }

            <div><b>Người xử lý:</b> @latest.NhanVien?.HoTen</div>
            <div><b>Ghi chú:</b> @latest.GhiChu</div>
            <div><b>Ngày xử lý:</b> @latest.NgayXuLy.ToString("dd-MM-yyyy HH:mm")</div>
        }

        <div class="mt-2">
            <a asp-controller="XuLyCongVan" asp-action="Create" asp-route-congVanId="@Model.ID" class="btn btn-primary btn-sm">
                Xử lý / Ghi nhận
            </a>
            <a asp-controller="XuLyCongVan" asp-action="History" asp-route-congVanId="@Model.ID" class="btn btn-secondary btn-sm">
                Xem lịch sử xử lý
            </a>
        </div>
    </div>
        <table id="myTable" class="table table-bordered">
            <tr>
                <th>Số hiệu</th>
                <td>@Model.SoHieu</td>
            </tr>
            <tr>
                <th>Ngày đi</th>
                <td>@Model.Ngay.ToString("dd-MM-yyyy")</td>
            </tr>
            <tr>
                <th>Nơi nhận</th>
                <td>@Model.NoiNhan?.TenNoiNhan</td>
            </tr>
            
            <tr>
                <th>Vị trí</th>
                <td>@Model.ViTri</td>
            </tr>
            <tr>
                <th>Nội dung</th>
                <td>@Model.NoiDung</td>
            </tr>
            <tr>
                <th>Tệp đính kèm</th>
                <td>
                    @if (!string.IsNullOrEmpty(Model.TepDinhKem))
                    {
                        var fileName = Model.TepDinhKem.Substring(Model.TepDinhKem.LastIndexOf('\\') + 1);
                        var fileExtension = fileName.Substring(fileName.LastIndexOf('.') + 1).ToLower();
                        var fileType = fileExtension switch {
                            "pdf" => "pdf",
                            "doc" => "doc",
                            "docx" => "docx",
                            "jpg" or "jpeg" or "png" => "image",
                            _ => "other"
                        };
                        
                        <div class="d-flex align-items-center">
                            <span class="me-2">@fileName</span>
                            <a href="@Url.Content("~/CongVanDi/download/" + Model.ID)" class="btn btn-sm btn-outline-primary me-2" download>
                                <i class="fas fa-download"></i> Tải xuống
                            </a>
                            @if (fileType != "other")
                            {
                                <button type="button" class="btn btn-sm btn-outline-success btn-preview" 
                                        data-file="@Model.TepDinhKem"
                                        data-type="@fileType">
                                    <i class="fas fa-eye"></i> Xem chi tiết
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <span>Không có tệp</span>
                    }
                </td>
            </tr>
            <tr>
                <th>Nội dung tệp</th>
                <td>@Model.NoiDungTep</td>
            </tr>
        </table>
        <div class="text-end">
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewModalLabel">Xem trước tệp đính kèm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="pdfViewer" style="display: none; width: 100%; height: 70vh;">
                    <iframe id="pdfIframe" style="width: 100%; height: 100%; border: none;"></iframe>
                </div>
                <div id="docViewer" style="display: none; width: 100%; height: 70vh;">
                    <iframe id="docIframe" style="width: 100%; height: 100%; border: none;"></iframe>
                </div>
                <div id="imageViewer" style="display: none; text-align: center;">
                    <img id="imagePreview" style="max-width: 100%; max-height: 70vh;" />
                </div>
                <div id="unsupportedViewer" style="display: none;">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> Không hỗ trợ xem trước định dạng này. Vui lòng tải xuống để xem.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
    <link rel="stylesheet" href="~/assets/css/styles.min.css" />

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-preview').on('click', function () {
                const filePath = $(this).data('file');
                const fileType = $(this).data('type');
                previewFile(filePath, fileType);
            });
        });

        function previewFile(filePath, fileType = pdf) {
            // Ẩn tất cả các viewer trước
            $('#pdfViewer, #docViewer, #imageViewer, #unsupportedViewer').hide();
            
            const modal = new bootstrap.Modal(document.getElementById('previewModal'));
            // Thay toàn bộ \ thành / để xử lý dễ hơn
            const normalizedPath = filePath.replaceAll("\\", "/");
            const fileIndex = normalizedPath.indexOf("/File/");
            const fileName = fileIndex !== -1 ? normalizedPath.substring(fileIndex) : "/" + normalizedPath.split("/").pop(); // Đảm bảo bắt đầu bằng /
            const fullUrl = window.location.origin + fileName;

            console.log('Attempting to preview file. Full URL:', fullUrl); // Gỡ lỗi
            
            if (fileType === 'pdf') {
                $('#pdfIframe').attr('src', fullUrl);
                $('#pdfViewer').show();
                $('#previewModalLabel').text('Xem trước PDF');
                modal.show();
            } 
            else if (fileType === 'doc' || fileType === 'docx') {
                const googleDocsUrl = `https://docs.google.com/gview?url=${encodeURIComponent(fullUrl)}&embedded=true`;
                $('#docIframe').attr('src', googleDocsUrl)
                .on('load', () => {
                    console.log('DOCX loaded successfully');
                    $('#docViewer').show();
                    $('#previewModalLabel').text('Xem trước Word');
                    modal.show();
                })
                .on('error', (e) => {
                    console.error('Error loading DOCX:', e);
                    $('#errorMessage').text('Không thể tải file từ Google Docs Viewer. Kiểm tra đường dẫn: ' + fullUrl);
                    $('#errorViewer').show();
                    $('#previewModalLabel').text('Lỗi khi xem trước');
                    modal.show();
                });
            } 
            else if (fileType === 'image') {
                $('#imagePreview').attr('src', fullUrl).on('load', () => {
                    $('#imageViewer').show();
                    $('#previewModalLabel').text('Xem trước hình ảnh');
                    modal.show();
                }).on('error', (e) => {
                    console.error('Error loading image:', e);
                    $('#errorMessage').text('Không thể tải hình ảnh. Kiểm tra đường dẫn: ' + fullUrl);
                    $('#errorViewer').show();
                    $('#previewModalLabel').text('Lỗi khi xem trước');
                    modal.show();
                });
            } 
            else {
                $('#unsupportedViewer').show();
                $('#previewModalLabel').text('Không hỗ trợ xem trước');
                modal.show();
            }
            $.ajax({
                url: '/congVanDi/GetNoiNhan', // đổi đúng tên controller/action bạn tạo
                type: 'GET',
                success: function (data) {
                    const select = $('#createIdNoiNhan');
                    select.empty(); // xóa option cũ
                    select.append('<option value="">-- Chọn nơi nhận --</option>');

                    $.each(data, function (i, item) {
                        select.append(`<option value="${item.id}">${item.tenNoiNhan}</option>`);
                    });
                },
                error: function () {
                    console.log("Lỗi khi tải danh sách nơi phát hành");
                }
            });
        }
    </script>
}