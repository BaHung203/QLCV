@model WebApp.ModelUI.CongVanCreateModel

<div class="modal fade" id="modalCongVan" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <form method="post" asp-action="Create"  enctype="multipart/form-data">
        <div class="modal-header text-center">
          <h5 class="modal-title w-100 text-center fw-bold" id="modalLabel"><b>Thêm Công Văn Đến</b></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <hr>
        <div class="modal-body">
          <div class="row">
            <div class="mb-3 col-md-6">
              <label for="SoHieu" class="form-label">Số hiệu</label>
              <input type="text" class="form-control" id="SoHieu" name="SoHieu" value="@Model?.SoHieu">
            </div>
            <div class="mb-3 col-md-6">
              <label for="Ngay" class="form-label">Ngày đến</label>
              <input type="date" class="form-control" id="NgayDen" name="Ngay" value="@Model?.Ngay.ToString("dd/MM/yyyy")">
            </div>

            <div class="mb-3 col-md-6">
                <label for="IdNoiPhatHanh" class="form-lable">Nơi phát hành</label>
                <select class="form-control" id="createIdNoiPhatHanh" name="IdNoiPhatHanh">
                <option value="">-- Chọn nơi phát hành--</option>
              </select>
            </div>
          
            <div class="mb-3 col-md-6">
              <label for="Vitri" class="form-label">Vị trí</label>
              <input type="text" class="form-control" id="Vitri" name="Vitri" value="@Model?.ViTri">
            </div>
            <div class="mb-3 col-md-6">
              <label for="file" class="form-label">Tệp đính kèm</label>
              <input type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" class="form-control" id="file" name="file">
            </div>
            <div class="mb-3 col-md-6">
              <label for="NoiDung" class="form-label">Nội dung</label>
              <textarea class="form-control" id="NoiDung" name="NoiDung">@Model?.NoiDung</textarea>
            </div>
            
            <div class="mb-3 col-md-6">
              <label for="NoiDungTep" class="form-label">Nội dung ghi chú cho tệp</label>
              <textarea class="form-control" disabled id="NoiDungTep"  name="NoiDungTep">@Model?.NoiDungTep</textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Lưu</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </form>
    </div>
  </div>
</div>
<script>
$(document).ready(function() {
        $('#modalCongVan form').on('submit', function (e) {
        // Reset các thông báo lỗi trước đó
        $('.form-control').removeClass('is-invalid');
        $('.invalid-feedback').remove();
        
        let isValid = true;
        
        // Danh sách các trường bắt buộc
        const requiredFields = [
            'SoHieu', 
            'NgayDen',
            'createIdNoiPhatHanh',
            'NoiDung',
            'Vitri',
            'file',
        ];
        
        // Kiểm tra từng trường bắt buộc
        requiredFields.forEach(function(fieldId) {
            const field = $('#' + fieldId);
            const value = field.val().trim();
            
            if (value === '' || value === '/' ) { // Giá trị mặc định của select
                field.addClass('is-invalid');
                field.after('<div class="invalid-feedback text-danger">Vui lòng nhập thông tin này</div>');
                isValid = false;
            }
        });
        
        // Nếu có lỗi thì ngăn form submit
        if (!isValid) {
            e.preventDefault();
            
            // Cuộn đến trường đầu tiên bị lỗi
            $('.is-invalid').first().focus();
        }
    });
    
    // Xóa thông báo lỗi khi người dùng bắt đầu nhập
    $('.form-control').on('input change', function() {
        $(this).removeClass('is-invalid');
        $(this).next('.invalid-feedback').remove();
    });
});
$(document).ready(function () {
    $.ajax({
        url: '/congVanDen/GetNoiPhatHanh', // đổi đúng tên controller/action bạn tạo
        type: 'GET',
        success: function (data) {
            const select = $('#createIdNoiPhatHanh');
            select.empty(); // xóa option cũ
            select.append('<option value="">-- Chọn nơi phát hành --</option>');

            $.each(data, function (i, item) {
                select.append(`<option value="${item.id}">${item.tenNoiPhatHanh}</option>`);
            });
        },
        error: function () {
            console.log("Lỗi khi tải danh sách nơi phát hành");
        }
    });
});
</script>