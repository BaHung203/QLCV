@model WebApp.Models.congVan
@using WebApp.Data
@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "Chi tiết công văn đến";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy xử lý mới nhất
    AppDbContext _db = Context.RequestServices.GetService(typeof(AppDbContext)) as AppDbContext;

    var latest = _db.XuLyCongVan
        .Include(x => x.NhanVien)
        .Where(x => x.IdCongVan == Model.ID)
        .OrderByDescending(x => x.NgayXuLy)
        .FirstOrDefault();
}

<div class="container-fluid">
 

    <!-- Trạng thái xử lý -->
    <div class="mb-3 p-3 border rounded bg-light">
        <h5>Trạng thái xử lý hiện tại:</h5>

        @if (latest == null)
        {
            <span class="badge bg-secondary">Chưa xử lý</span>
        }
        else
        {
            if (latest.TrangThai == WebApp.Libs.TrangThaiXuLy.DangCho)
            {
                <span class="badge bg-secondary">Đang chờ</span>
            }
            else if (latest.TrangThai == WebApp.Libs.TrangThaiXuLy.DangXuLy)
            {
                <span class="badge bg-warning text-dark">Đang xử lý</span>
            }
            else if (latest.TrangThai == WebApp.Libs.TrangThaiXuLy.DaHoanThanh)
            {
                <span class="badge bg-success">Đã xử lý</span>
            }

            <div><b>Người xử lý:</b> @latest.NhanVien?.HoTen</div>
            <div><b>Ghi chú:</b> @latest.GhiChu</div>
            <div><b>Ngày xử lý:</b> @latest.NgayXuLy.ToString("dd-MM-yyyy HH:mm")</div>
        }

        <div class="mt-2">
            <a asp-controller="XuLyCongVan" asp-action="Create" asp-route-congVanId="@Model.ID" class="btn btn-primary btn-sm">
                Xử lý / Ghi nhận
            </a>
            <a asp-controller="XuLyCongVan" asp-action="History" asp-route-congVanId="@Model.ID" class="btn btn-secondary btn-sm">
                Xem lịch sử xử lý
            </a>
        </div>
    </div>

    <!-- THÔNG TIN CHI TIẾT -->
    <table class="table table-bordered">
        <tr>
            <th>Số hiệu</th>
            <td>@Model.SoHieu</td>
        </tr>
        <tr>
            <th>Ngày nhận</th>
            <td>@Model.Ngay.ToString("dd-MM-yyyy")</td>
        </tr>
        <tr>
            <th>Nơi phát hành</th>
            <td>@Model.NoiPhatHanh?.TenNoiPhatHanh</td>
        </tr>
        <tr>
            <th>Vị trí</th>
            <td>@Model.ViTri</td>
        </tr>
        <tr>
            <th>Nội dung</th>
            <td>@Model.NoiDung</td>
        </tr>

        <!-- TẬP TIN ĐÍNH KÈM -->
        <tr>
            <th>Tệp đính kèm</th>
            <td>
                @if (!string.IsNullOrEmpty(Model.TepDinhKem))
                {
                    var fileName = System.IO.Path.GetFileName(Model.TepDinhKem);
                    var ext = System.IO.Path.GetExtension(fileName).ToLower();

                    var fileType = ext switch {
                        ".pdf" => "pdf",
                        ".doc" or ".docx" => "doc",
                        ".jpg" or ".jpeg" or ".png" => "image",
                        _ => "other"
                    };

                    <div class="d-flex align-items-center">
                        <span class="me-2">@fileName</span>

                        <a href="@Url.Content("~/CongVanDen/download/" + Model.ID)"
                           class="btn btn-sm btn-outline-primary me-2" download>
                            <i class="fas fa-download"></i> Tải xuống
                        </a>

                        @if (fileType != "other")
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-success btn-preview"
                                    data-file="@Model.TepDinhKem"
                                    data-type="@fileType">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </button>
                        }
                    </div>
                }
                else
                {
                    <span>Không có tệp</span>
                }
            </td>
        </tr>

        <tr>
            <th>Nội dung tệp</th>
            <td>@Model.NoiDungTep</td>
        </tr>
    </table>

    <div class="text-end">
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>


<!-- ================= MODAL PREVIEW ================== -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewModalLabel">Xem trước tệp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="pdfViewer" style="display:none;height:70vh">
                    <iframe id="pdfIframe" style="width:100%;height:100%;border:none;"></iframe>
                </div>

                <div id="docViewer" style="display:none;height:70vh">
                    <iframe id="docIframe" style="width:100%;height:100%;border:none;"></iframe>
                </div>

                <div id="imageViewer" style="display:none;text-align:center">
                    <img id="imagePreview" style="max-width:100%;max-height:70vh" />
                </div>

                <div id="unsupportedViewer" style="display:none">
                    <div class="alert alert-warning">Không hỗ trợ xem trước định dạng này.</div>
                </div>

                <div id="errorViewer" style="display:none">
                    <div class="alert alert-danger">Lỗi xem file: <span id="errorMessage"></span></div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="~/assets/css/styles.min.css" />


@section Scripts {
<script>
    $(document).ready(function () {
        $('.btn-preview').click(function () {
            previewFile($(this).data('file'), $(this).data('type'));
        });
    });

    function previewFile(filePath, fileType) {

        $('#pdfViewer,#docViewer,#imageViewer,#unsupportedViewer,#errorViewer').hide();

        const modal = new bootstrap.Modal(document.getElementById('previewModal'));

        const clean = filePath.replaceAll("\\", "/");
        const fileName = clean.substring(clean.indexOf("/File/"));
        const fullUrl = window.location.origin + fileName;

        if (fileType === 'pdf') {
            $('#pdfIframe').attr('src', fullUrl);
            $('#pdfViewer').show();
            modal.show();
        }
        else if (fileType === 'doc') {
            const gview = `https://docs.google.com/gview?url=${encodeURIComponent(fullUrl)}&embedded=true`;
            $('#docIframe').attr('src', gview);
            $('#docViewer').show();
            modal.show();
        }
        else if (fileType === 'image') {
            $('#imagePreview').attr('src', fullUrl);
            $('#imageViewer').show();
            modal.show();
        }
        else {
            $('#unsupportedViewer').show();
            modal.show();
        }
        $.ajax({
            url: '/congVanDen/GetNoiPhatHanh', // đổi đúng tên controller/action bạn tạo
            type: 'GET',
            success: function (data) {
                const select = $('#createIdNoiPhatHanh');
                select.empty(); // xóa option cũ
                select.append('<option value="">-- Chọn nơi phát hành --</option>');

                $.each(data, function (i, item) {
                    select.append(`<option value="${item.id}">${item.tenNoiPhatHanh}</option>`);
                });
            },
            error: function () {
                console.log("Lỗi khi tải danh sách nơi phát hành");
            }
        });
    }
</script>
}
