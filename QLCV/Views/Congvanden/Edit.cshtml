@model WebApp.ModelUI.CongVanUpdateModel
@{
   ViewData["Title"] = "Edit";
   
}

<div class="modal fade" id="modalEditCongVan" tabindex="-1" aria-labelledby="modalEditLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <form method="post" asp-action="Edit" enctype="multipart/form-data">
        <input type="hidden" id="editId" name="Id" value="@Model?.ID" />
        <div class="modal-header">
          <h5 class="modal-title  w-100 text-center" id="modalEditLabel"><b>Cập Nhật Công Văn Đến</b></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <hr>
        <div class="modal-body">
          <div class="row">
            <div class="mb-3 col-md-6">
              <label for="editSoHieu" class="form-label">Số hiệu</label>
              <input type="text" class="form-control" id="editSoHieu" name="SoHieu" value="">
            </div>
            <div class="mb-3 col-md-6">
              <label for="Ngay" class="form-label">Ngày đến</label>
              <input type="date" class="form-control" id="Ngay" name="Ngay">
            </div>
            <div class="mb-3 col-md-6">
                <label for="IdNoiPhatHanh" class="form-lable">Nơi phát hành</label>
                <select class="form-control" id="editIdNoiPhatHanh" name="IdNoiPhatHanh">
                  <option value="">-- Chọn nơi phát hành--</option>
                </select>
            </div>
        
            <div class="mb-3 col-md-6">
              <label for="editViTri" class="form-label">Vị trí</label>
              <input type="text" class="form-control" id="editViTri" name="ViTri">
            </div>
             <div class="mb-3 col-md-6">
              <label for="File" class="form-label">Tệp đính kèm</label>
              <input type="File" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" class="form-control" id="File" name="File">
              <small id="fileNameDisplay" class="form-text text-muted"></small>
            </div>
            <div class="mb-3 col-md-6">
              <label for="editNoiDung" class="form-label">Nội dung</label>
              <textarea class="form-control" id="editNoiDung" name="NoiDung"></textarea>
            </div>
           
            <div class="mb-3 col-md-6">
              <label for="NoiDungTep" class="form-label">Nội dung tệp</label>
              <textarea class="form-control" disabled id="NoiDungTep" name="NoiDungTep"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Lưu</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </form>
    </div>
  </div>
</div>


