@using WebApp.Libs
@model WebApp.Models.nhanVien

@{
    ViewData["Title"] = "Sửa nhân viên";
}


<div class="modal fade" id="modalEditNhanVien" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
     <form method="post" asp-action="Edit" asp-controller="NhanVien" enctype="multipart/form-data">
        <input type="hidden" id="editIdNhanVien" name="idNhanVien" value="@Model?.IdNhanVien"/>
        <div class="modal-header text-center">
          <h5 class="modal-title w-100 text-center fw-bold" id="modalLabel"><b>Sửa Nhân Viên</b></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <hr>
        <div class="modal-body">
          <div class="row">
            <div class="mb-3 col-md-6">
              <label for="HoTen" class="form-label">Họ Tên</label>
              <input type="text" class="form-control" id="HoTen" name="HoTen"  />
            </div>
            <div class="mb-3 col-md-6">
              <label for="NgaySinh" class="form-label">Ngày Sinh</label>
              <input type="date" class="form-control" id="NgaySinh" name="NgaySinh" />
            </div>
            <div class="mb-3 col-md-6">
              <label for="GioiTinh" class="form-label">Giới Tính</label>
              <input type="text" class="form-control" id="GioiTinh" name="GioiTinh" />
            </div>
            <div class="mb-3 col-md-6">
              <label for="SoDienThoai" class="form-label">Số Điện Thoại</label>
              <input class="form-control" id="SoDienThoai" maxlength="10" pattern="\d{10}" name="SoDienThoai"  />
            </div>
            
            <div class="mb-3 col-md-6">
              <label for="Email" class="form-label">Email</label>
              <input class="form-control" id="Email" name="Email"  />
            </div>
            <div class="mb-3 col-md-6">
              <label for="ChucVu" class="form-label">Chức Vụ</label>
              <input class="form-control" id="ChucVu" name="ChucVu" />
            </div>
            <div class="mb-3 col-md-6">
              <label for="IdPhongBan" class="form-label">Phòng ban</label>
              <select class="form-control" id="IdEditPhongBan" name="IdPhongBan">
                <option value="">-- Chọn phòng ban --</option>
              </select>
            </div>
          </div>
          <!-- Account section (edit) -->
          <div class="card mt-3">
            <div class="card-header">
              <strong>Account</strong>
            </div>
            <div class="card-body">
              <div class="row">
                @* Hidden Account Id so binder updates existing account if present *@
                <input type="hidden" name="Account.Id" value="@Model?.Account?.Id" />

                <div class="mb-3 col-md-6">
                  <label for="username" class="form-label">Username</label>
                  <input class="form-control" id="username" name="Account.Username" value="@Model?.Account?.Username" />
                </div>
                <div class="mb-3 col-md-6">
                  <label for="password" class="form-label">Password</label>
                  <input class="form-control" id="password" name="Account.Password" type="password" value="@Model?.Account?.Password" />
                </div>

                <div class="mb-3 col-md-6">
                  <label for="accountRole" class="form-label">Role</label>
                  <select class="form-control" id="accountRole" name="Account.Role">
                    <option value="">-- Chọn vai trò --</option>
                    @foreach (WebApp.Libs.UserRole r in Enum.GetValues(typeof(UserRole)))
                    {
                        if(Model?.Account != null && Model.Account.Role == r)
                        {
                            <option value="@r" selected>@r.ToString()</option>               
                        }else{
                            <option value="@r">@r.ToString()</option>
                        }
                    }
                  </select>
                </div>
              </div>
            </div>
          </div>
          <!-- End account section -->
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Lưu</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </form>
    </div>
  </div>
</div>
