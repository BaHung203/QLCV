    <!-- Footer -->
    
@await RenderSectionAsync("Scripts", required: false)
<script>
    document.addEventListener('DOMContentLoaded', function () {
    const badge = document.getElementById('notificationBadge');
    const list = document.getElementById('notificationList');

    // Ẩn badge nếu chưa có thông báo
    if (!badge.textContent || parseInt(badge.textContent) === 0) {
        badge.style.display = 'none';
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationHub")
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveNotification", (data) => {
        console.log("Nhận thông báo:", data);

        // Tạo item thông báo
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.className = "dropdown-item";
        a.href = "#"; // hoặc link tới công văn: `/CongVanDen/ChiTiet/${data.id}`
        a.innerHTML = `
            <div class="d-flex align-items-center">
                <div>
                    <strong>${data.tieuDe || 'Có công văn mới'}</strong><br>
                    <small class="text-muted">${data.ngayTao || new Date().toLocaleString('vi-VN')}</small>
                </div>
            </div>`;
        li.appendChild(a);

        // Chèn sau <hr>
        const hr = list.querySelector('hr.dropdown-divider');
        if (hr && hr.nextSibling) {
            list.insertBefore(li, hr.nextSibling);
        } else {
            list.appendChild(li);
        }

        // Tăng badge
        let count = parseInt(badge.textContent) || 0;
        count++;
        badge.textContent = count;
        badge.style.display = 'block'; // hiện badge
    });

    connection.start()
        .then(() => console.log("SignalR Connected"))
        .catch(err => console.error("SignalR Error:", err));
});

</script>
