@model WebApp.Models.XuLyCongVan
@using WebApp.Libs

@{
    var congVan = ViewBag.CongVan as WebApp.Models.congVan;
    var nhanVienList = ViewBag.NhanVienList as List<WebApp.Models.nhanVien>;

    ViewData["Title"] = "Xử lý công văn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // === XÁC ĐỊNH CONTROLLER DETAILS AN TOÀN ===
    string controllerDetails;
    if (congVan == null)
    {
        controllerDetails = "CongVanDen"; // fallback
    }
    else
    {
        // Nếu LoaiCongVan là enum, xử lý bằng switch để tránh lỗi so sánh
        switch (congVan.LoaiCongVan)
        {
            case LoaiCongVan.CongVanDen: // nếu enum của bạn có tên khác, giữ cho an toàn
                controllerDetails = "CongVanDen";
                break;

            case LoaiCongVan.CongVanDi:
                controllerDetails = "CongVanDi";
                break;

            default:
                controllerDetails = "CongVanDen";
                break;
        }
    }
}

<h3 class="mb-4">Xử lý Công văn: @congVan?.SoHieu</h3>

<form asp-controller="XuLyCongVan" asp-action="Create" method="post">

    <input type="hidden" asp-for="IdCongVan" value="@congVan?.ID" />

    <!-- CHỌN NHÂN VIÊN -->
    <div class="mb-3">
        <label class="form-label fw-bold">Người xử lý</label>
        <select class="form-select" asp-for="IdNhanVien" required>
            <option value="">-- Chọn nhân viên --</option>
            @if (nhanVienList != null)
            {
                foreach (var nv in nhanVienList)
                {
                    <option value="@nv.IdNhanVien">@nv.HoTen</option>
                }
            }
        </select>
    </div>

    <!-- TRẠNG THÁI -->
    <div class="mb-3">
        <label class="form-label fw-bold">Trạng thái</label>
        <select class="form-select" asp-for="TrangThai">
            @foreach (var value in Enum.GetValues(typeof(TrangThaiXuLy)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>

    <!-- GHI CHÚ -->
    <div class="mb-3">
        <label class="form-label fw-bold">Ghi chú</label>
        <textarea class="form-control" asp-for="GhiChu" rows="3" placeholder="Nhập ghi chú..."></textarea>
    </div>

    <!-- BUTTON -->
    <button type="submit" class="btn btn-primary">Lưu</button>

    <a asp-controller="@controllerDetails"
       asp-action="Details"
       asp-route-id="@congVan?.ID"
       class="btn btn-secondary ms-2">
        Hủy
    </a>
</form>

<link rel="stylesheet" href="~/assets/css/styles.min.css" />
